{
  "name": "novaswarm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NOVA SWARM, a neon roguelite wave-survivor, rebuilt with Aholo Lux3D for the Manycore Aholo Global 3D AI Hackathon.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "smoke": "node test/smoke.mjs",
    "test": "vitest run",
    "smoke:coop": "node test/coop-smoke.mjs",
    "smoke:chat": "node test/chat-smoke.mjs",
    "assets": "node tools/lux3d/generate.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.185.1",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.61.1",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@nexconn/chat": "^26.2.1",
    "@nexconn/engine": "^26.2.1",
    "three": "^0.185.1"
  }
}
